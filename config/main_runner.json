{
  "version": "main-runner-v1",
  "experiment": "dlcssm_main",
  "purpose": "publication",
  "seed": 42,
  "threads": 3,
  "inner_threads": 1,
  "publication_mode": true,
  "stages": {
    "synthetic": {"config": "config/synthetic_main.json", "enabled": true, "required": true},
    "real_data": {"dataset": "data/processed/dataset.npz", "data_config": "config/data.yaml", "prepare": false, "enabled": true, "required": true},
    "causal_support": {
      "dataset": "data/processed/dataset.npz",
      "causal_config": "config/causal.yaml",
      "model_config": "config/dlcssm.yaml",
      "enabled": true,
      "required": true,
      "jobs": 2
    },
    "model": {"dataset": "data/processed/dataset.npz", "model_config": "config/dlcssm.yaml", "enabled": true, "required": true},
    "baselines": {"dataset": "data/processed/dataset.npz", "config": "config/baselines.json", "enabled": true, "required": true},
    "oos": {"dataset": "data/processed/dataset.npz", "feature_config": "config/oos_final.json", "predictive_config": "config/oos_predictive.json", "enabled": true, "required": true},
    "geometry": {"enabled": true, "required": true, "horizon": 10, "block_length": 20, "bootstrap_count": 1000, "seed": 42, "progress": true, "timeout_seconds": 86400, "memory_gb": 40},
    "ablation_falsification": {"dataset": "data/processed/dataset.npz", "horizon": 5, "seed": 42, "enabled": true, "required": true},
    "coverage": {"enabled": true, "required": true}
  }
}
