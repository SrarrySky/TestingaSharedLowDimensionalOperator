{
  "purpose": "engineering_smoke",
  "scenarios": ["s0", "s1", "s2", "s3", "s4", "s5", "s6", "s7"],
  "seeds": [7, 19],
  "T": 180,
  "n": 4,
  "lag": 2,
  "train_count": 110,
  "validation_count": 30,
  "methods": ["static", "sparse", "tvp", "smooth", "network", "hmm", "dlc"],
  "baselines": {
    "lags": [1, 2],
    "ridges": [0.1, 1.0],
    "lasso_alphas": [0.01, 0.05],
    "process_variances": [0.00001, 0.001],
    "smooth_lag": 2,
    "smooth_bandwidths": [20, 40],
    "smooth_ridge": 1.0,
    "horizon": 5,
    "n_regimes": 2,
    "hmm_n_init": 2,
    "hmm_n_iter": 40
  },
  "dlc": {
    "seed": 7,
    "lag": 2,
    "state_dimension": 2,
    "selection": {"covariate_policy": "persistence"},
    "fit": {
      "max_em_iterations": 6,
      "min_em_iterations": 2,
      "tolerance": 0.00001,
      "prox_iterations": 20,
      "covariance_jitter": 0.000001,
      "diagonal_observation_covariance": true,
      "canonicalize_after_fit": true
    },
    "penalty": {"tier_b_multiplier": 2.0, "group": 0.001, "state_l1": 0.0005, "ridge": 0.000001},
    "stability": {
      "validation_reject_if_spectral_radius_above": 1.02,
      "diagnostic_state_quantiles": [0.05, 0.5, 0.95]
    },
    "hyperparameter_grid": {"state_dimension": [1, 2]}
  },
  "support": {
    "method": "linear_lasso",
    "seed": 7,
    "lag": 2,
    "bootstrap_count": 3,
    "block_length": 10,
    "bootstrap_mode": "moving_block",
    "stability_threshold": 0.7,
    "union_screen_threshold": 0.5,
    "support_mode": "stable",
    "rolling_contexts": 0,
    "parallel": {"n_jobs": 1},
    "linear_lasso": {"alpha": 0.02, "max_iter": 10000, "coef_zero_tolerance": 0.000000000001}
  }
}
